# Local settings for the scripts in this repository.
# Copy this file to .env in the same directory and fill in the values:
#   cp .env.example .env && chmod 600 .env
# .env is listed in .gitignore and must never be committed.
# One KEY=VALUE per line, shell syntax; quote values that contain spaces or
# special characters. Variables already exported in the shell take precedence.

# Username on all remote hosts (default: the local user name).
SSH_USER=

# DCS host: ssh_dcs, download_rrlog. Leave the password empty to use SSH keys.
#DCS_SSH_HOST=dcs-sh01.nvidia.com
#DCS_SSH_USER=
DCS_SSH_PASSWORD=

# Lab PC: ssh_pc. Leave the password empty to use SSH keys.
#PC_SSH_HOST=10.19.183.180
#PC_SSH_USER=
PC_SSH_PASSWORD=

# Drive-farm bot PCs: ssh_drivefarm / ssh_bot. Site is oregon or santaclara.
#DRIVEFARM_SITE=oregon
#DRIVEFARM_USER=
#DRIVEFARM_VNC_LOCAL_PORT=5910
#DRIVEFARM_VNC_REMOTE_PORT=5901

# rr-dt jump-host setup: setup_rr_dt_ssh.
#RR_DT_USER=
#RR_DT_JUMP_USER=
#RR_DT_HOST=rr-dt.nvidia.com
#RR_DT_JUMP_HOST=dc2-container-xterm-011.prd.it.nvidia.com
#RR_DT_JUMP_PORT=2704

# Maglev CLI: setup_maglev.
MAGLEV_API_KEY=

# rrLog download: download_rrlog, download_rrlog.py. $HOME is expanded.
#RRLOG_LOCAL_DIR=$HOME/Downloads/claude_rrLog/rrLog
#NDAS_WORKSPACE=$HOME/workspace/ndas
#RRLOG_DOC_PATH=$HOME/Downloads/claude_rrLog/ComputeGraphFrameworkDocumentation.docx
